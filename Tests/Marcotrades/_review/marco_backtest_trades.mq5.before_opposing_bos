// Cache records contain no strings/dynamic arrays, so FileWriteStruct is safe.
// Text fields are stored separately with explicit UTF-16 lengths.
struct STradeCacheHeader
  {
   int magic, version, nextTF, waitAttempts, skipped, totalTrades, wins, losses;
   int records, overlapRecords, vicinityTF;
   datetime windowEnd;
   double rewards;
   bool finished;
  };
struct STradeCacheRecord
  {
   SMarcoTPPlan plan;
   int tf, direction;
   ulong ticket;
   datetime opened, closed, windowEnd;
   double entry, sl, tp, exitPrice, lots, profit;
  };
struct STradeCacheOverlap
  {
   int setupTF;
   ulong ticket;
   datetime openTime, closeTime;
   double openPrice, tpPrice;
   int direction;
  };

